<Window x:Class="BIMPlugins.Windows.RevitServer.Windows.MultiFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:classes="clr-namespace:BIMPlugins.Windows.RevitServer.Classes"
        xmlns:converters="clr-namespace:BIMPlugins.Windows.Converters"
        xmlns:localization="clr-namespace:BIMPlugins.Windows.Properties"
        xmlns:local="clr-namespace:BIMPlugins.Windows.RevitServer.ViewModels"
        d:DataContext="{d:DesignInstance local:MultiFilesViewModel}"
        mc:Ignorable="d"
        Height="700" Width="450" ResizeMode="NoResize" Title="{x:Static localization:Resources.MultiWindowTitle}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BIMPluginsTheme BaseTheme="Light" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EscapeUnderscoreConverter x:Key="EscapeUnderscoreConverter" />
            <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <materialDesign:BooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Image Source="/BIMPlugins.Windows;component/Resources/search-32.png" Height="20" Width="20" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="5 0" Margin="0 5" Height="22" 
                     materialDesign:HintAssist.Hint="{x:Static localization:Resources.Filter}"
                     materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FilterKeyDownCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <materialDesign:PackIcon Grid.Column="2" Kind="InformationOutline" Height="22" Width="22" Margin="5" Padding="0" ToolTipService.InitialShowDelay="10">
                <materialDesign:PackIcon.ToolTip>
                    <TextBlock Text="{x:Static localization:Resources.RegexInfo}" TextWrapping="Wrap" FontSize="14"/>
                </materialDesign:PackIcon.ToolTip>
            </materialDesign:PackIcon>
        </Grid>

        <Button Panel.ZIndex="1" Width="25" Height="25" Padding="0" Margin="5 0 25 -35" HorizontalAlignment="Right" 
                Command="{Binding ResetAllExpandedCommand}" CommandParameter="{Binding ServerItems}"
                Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static localization:Resources.Collapse}">
            <materialDesign:PackIcon Kind="ArrowCollapse" Width="25" Height="25" Foreground="Black"/>
        </Button>
        <Border Margin="5" Padding="0" BorderThickness="1" BorderBrush="{StaticResource BIMPlugins.PrimaryBrush}" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}">
            <TreeView Panel.ZIndex="0" ItemsSource="{Binding ServerItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="450" MaxHeight="450"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="0" Padding="0" 
                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>

                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>

                    <HierarchicalDataTemplate DataType="{x:Type classes:FolderItem}" ItemsSource="{Binding Items}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/BIMPlugins.Windows;component/Resources/server.png" Height="18" Width="18" Margin="0 2"
                                   Visibility="{Binding IsServer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <materialDesign:PackIcon Height="20" Width="20" VerticalAlignment="Center" Kind="FolderOutline"
                                                     Visibility="{Binding IsServer, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>

                            <Label Content="{Binding Name, Converter={StaticResource EscapeUnderscoreConverter}}" Height="23" VerticalAlignment="Center"/>

                            <CheckBox IsChecked="{Binding IsSelected}" Margin="5 2 0 0" Padding="0" VerticalAlignment="Center"
                                      ToolTip="{x:Static localization:Resources.SelectChildren}"
                                      Command="{Binding DataContext.FolderCheckedCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                      CommandParameter="{Binding}">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServer}" Value="true">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsServer}" Value="false">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type classes:FileItem}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2 0" Height="23"
                                      Content="{Binding Name, Converter={StaticResource EscapeUnderscoreConverter}}"
                                      Command="{Binding DataContext.ProjectCheckedCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                      CommandParameter="{Binding}">
                                <CheckBox.ContextMenu>
                                    <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                        <MenuItem Header="{x:Static localization:Resources.Copy}"
                                                  Icon="{materialDesign:PackIcon Kind=ContentCopy}" Command="{Binding CopyPathCommand}"/>
                                    </ContextMenu>
                                </CheckBox.ContextMenu>
                            </CheckBox>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Border Margin="5 0" Padding="0" BorderThickness="1" BorderBrush="{StaticResource BIMPlugins.PrimaryBrush}" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}">
            <ListBox ItemsSource="{Binding Projects}" SelectionMode="Single" Height="125" MaxHeight="125" materialDesign:ListBoxItemAssist.ShowSelection="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="5 2" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding FilePath}"/>
                            <Button Width="18" Height="18" Padding="0" Margin="5 0"
                                    Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static localization:Resources.Remove}">
                                <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Style="{StaticResource MaterialDesignPaperButton}" Content="{x:Static localization:Resources.Done}" Margin="5" Height="25" Padding="0"
                Command="{Binding RunCommand}"/>
    </StackPanel>
</Window>