<Window x:Class="BIMPlugins.Windows.RevitServer.Windows.OneFileWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:classes="clr-namespace:BIMPlugins.Windows.RevitServer.Classes"
        xmlns:controls="clr-namespace:BIMPlugins.Windows.Controls"
        xmlns:converters="clr-namespace:BIMPlugins.Windows.Converters"
        xmlns:localization="clr-namespace:BIMPlugins.Windows.Properties"
        xmlns:local="clr-namespace:BIMPlugins.Windows.RevitServer.ViewModels"
        d:DataContext="{d:DesignInstance local:OneFileViewModel}"
        mc:Ignorable="d"
        Height="700" Width="450" ResizeMode="NoResize" Title="{x:Static localization:Resources.OneWindowTitle}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BIMPluginsTheme BaseTheme="Light" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EscapeUnderscoreConverter x:Key="EscapeUnderscoreConverter" />
            <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <materialDesign:BooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Image Source="/BIMPlugins.Windows;component/Resources/search-32.png" Height="20" Width="20" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Padding="5 0" Margin="0 5" Height="22" materialDesign:HintAssist.Hint="{x:Static localization:Resources.Filter}"
                     materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FilterKeyDownCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <materialDesign:PackIcon Grid.Column="2" Kind="InformationOutline" Height="22" Width="22" Margin="5" Padding="0" ToolTipService.InitialShowDelay="10">
                <materialDesign:PackIcon.ToolTip>
                    <TextBlock Text="{x:Static localization:Resources.RegexInfo}" TextWrapping="Wrap" FontSize="14"/>
                </materialDesign:PackIcon.ToolTip>
            </materialDesign:PackIcon>
        </Grid>

        <Button Panel.ZIndex="1" Width="25" Height="25" Padding="0" Margin="5 0 22 -35" Command="{Binding ResetAllExpandedCommand}"
                CommandParameter="{Binding ServerItems}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}"
                ToolTip="{x:Static localization:Resources.Collapse}">
            <materialDesign:PackIcon Kind="ArrowCollapse" Width="25" Height="25" Foreground="Black"/>
        </Button>
        <controls:ListFrame Margin="5">
            <TreeView Panel.ZIndex="0" ItemsSource="{Binding ServerItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="580" MaxHeight="580"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="0" Padding="0" 
                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding TreeItemClickedCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <TreeView.Resources>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>

                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>

                    <HierarchicalDataTemplate DataType="{x:Type classes:FolderItem}" ItemsSource="{Binding Items}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/BIMPlugins.Windows;component/Resources/server.png" Height="18" Width="18" Margin="0 2"
                                   Visibility="{Binding IsServer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <materialDesign:PackIcon Height="20" Width="20" VerticalAlignment="Center" Kind="FolderOutline"
                                                     Visibility="{Binding IsServer, Converter={StaticResource InvertBooleanToVisibilityConverter}}" />

                            <Label Content="{Binding Name, Converter={StaticResource EscapeUnderscoreConverter}}" Height="23" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type classes:FileItem}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/BIMPlugins.Windows;component/Resources/revit_file_open.ico" />
                            <Label Height="23" Content="{Binding Name, Converter={StaticResource EscapeUnderscoreConverter}}">
                                <Label.ContextMenu>
                                    <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                        <MenuItem Header="{x:Static localization:Resources.Copy}" Icon="{materialDesign:PackIcon Kind=ContentCopy}"
                                                  Command="{Binding CopyPathCommand}"/>
                                    </ContextMenu>
                                </Label.ContextMenu>
                            </Label>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </controls:ListFrame>

        <Button Style="{StaticResource MaterialDesignPaperButton}" Content="{x:Static localization:Resources.Done}" Margin="5" Height="25" Padding="0"
                Command="{Binding RunCommand}"/>
    </StackPanel>
</Window>