<Window x:Class="BIMPlugins.Windows.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BIMPlugins.Windows.ViewModels"
        d:DataContext="{d:DesignInstance local:MessageViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}" MinHeight="150" MinWidth="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BIMPluginsTheme BaseTheme="Light" />
            </ResourceDictionary.MergedDictionaries>

            <materialDesign:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
    </Window.InputBindings>

    <Border Padding="5">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <materialDesign:PackIcon Kind="{Binding Icon}" Margin="5" Height="35" Width="35" VerticalAlignment="Top"
                                     Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                     Visibility="{Binding Icon, Converter={StaticResource NullableToVisibilityConverter}}"/>

            <!-- A long message scrolls instead of growing past the screen. -->
            <ScrollViewer Grid.Column="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center" Focusable="False">
                <TextBlock Text="{Binding Message}" Margin="5" TextWrapping="Wrap" MaxWidth="400"/>
            </ScrollViewer>

            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MessageButton}">
                        <Button Margin="5 10 5 5" MinWidth="90" Padding="15 0" Height="25" Content="{Binding Text}"
                                IsDefault="{Binding IsDefault}" IsCancel="{Binding IsCancel}"
                                Style="{StaticResource MaterialDesignPaperButton}"
                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Result}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
